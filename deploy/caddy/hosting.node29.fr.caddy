# --- Orion hosting panel -----------------------------------------------------
# Append this block to the edge Caddyfile (/srv/caddy/Caddyfile) and reload:
#   docker exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# Reachable from the LAN and the tailnet only; 403 for everything else. Pair it
# with an A record for hosting.node29.fr and *.hosting.node29.fr pointing at
# this host, so the names resolve but stay unreachable from the open internet.
#
# The apex serves the panel. Every subdomain is a tenant website, routed by the
# dedicated tenant Caddy that Orion configures over its admin API.

hosting.node29.fr, *.hosting.node29.fr {
	@external not remote_ip 192.168.1.0/24 100.64.0.0/10
	respond @external 403

	# Panel (apex).
	@panel host hosting.node29.fr
	handle @panel {
		reverse_proxy orion:8000
	}

	# Tenant websites (any subdomain). orion-caddy joins the shared "gpi"
	# network so this name resolves.
	handle {
		reverse_proxy orion-caddy:8080
	}

	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer-when-downgrade"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
}
