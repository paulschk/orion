# --- Orion hosting panel -----------------------------------------------------
# Append this block to the edge Caddyfile (/srv/caddy/Caddyfile) and reload:
#   docker exec caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   docker exec caddy caddy reload   --config /etc/caddy/Caddyfile --adapter caddyfile
#
# The apex serves the panel and its presentation pages, and answers 403 to
# everything outside the LAN. Every subdomain is a tenant website, routed by the
# dedicated tenant Caddy that Orion configures over its admin API — those are the
# clients' sites, so they are their own block and are not gated.
#
# Pair it with an A record for hosting.node29.fr and *.hosting.node29.fr pointing
# at this host, so the names resolve.
#
# The gate is a `handle` block, not a site-level `respond`, and that is not a
# matter of style. Caddy sorts a site's directives by its own default order,
# which puts the `handle` blocks first; the first `handle` that matches is
# terminal, so a `respond` written above them runs *after* one has already
# answered — that is, never. Written that way the gate sits in the running
# config, looks right on every reading, and does nothing at all: the panel
# answers the open internet. `handle` blocks are evaluated in the order written,
# so the gate goes first, inside one.
#
# Measured on the panel before the fix: five nodes from five different networks
# received 200 on /healthz. After it: five received 403, and the LAN kept 200.

hosting.node29.fr {
	@external not remote_ip 192.168.1.0/24
	handle @external {
		respond 403
	}

	handle {
		reverse_proxy orion:8000
	}

	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer-when-downgrade"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
}

*.hosting.node29.fr {
	reverse_proxy orion-caddy:8080

	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer-when-downgrade"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
}
