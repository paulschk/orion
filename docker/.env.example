# --- Identity -----------------------------------------------------------
ORION_BRAND=node29
ORION_APP_NAME=Orion
ORION_DOMAIN=hosting.node29.fr
ORION_BASE_URL=https://hosting.node29.fr

# --- Secrets ------------------------------------------------------------
# Generate with:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
ORION_SECRET_KEY=change-me-please

# Initial admin account, created on first boot if it does not exist.
ORION_ADMIN_EMAIL=paul.schmitt.pro@gmail.com
ORION_ADMIN_PASSWORD=change-me-on-first-login

# --- Incus --------------------------------------------------------------
ORION_INCUS_BIN=incus
ORION_INCUS_PROJECT=default
ORION_INCUS_POOL=orion
ORION_INCUS_NETWORK=incusbr0
ORION_INCUS_IMAGE=images:debian/12
ORION_INCUS_SOCKET=/var/lib/incus/unix.socket

# --- Client access ------------------------------------------------------
# Host clients SSH to. Public DNS for hosting.node29.fr resolves to the panel
# host, so the same name works for SSH and the dashboard.
# Public address clients point their own domain at (shown in the panel).
ORION_INGRESS_IP=
ORION_SSH_HOST=hosting.node29.fr
ORION_SSH_PORT_MIN=20000
ORION_SSH_PORT_MAX=20999
ORION_SSH_USER=orion

# --- Tenant web routing -------------------------------------------------
ORION_CADDY_ADMIN=http://orion-caddy:2019
# Shared with the orion-caddy container (bind-mounted at /etc/caddy there).
ORION_CADDY_CONFIG=/caddy/caddy.json
ORION_TENANT_LISTEN=:8080

# --- Capacity -----------------------------------------------------------
# Resources held back from the host for the panel itself and the OS. Orion
# sells whatever is left. Set to 0 to sell everything.
ORION_RESERVE_VCPU=1
ORION_RESERVE_RAM_MB=1536
ORION_RESERVE_DISK_GB=10
# Optional hard overrides; left blank Orion auto-detects from the host.
ORION_CPU_TOTAL=
ORION_RAM_TOTAL_MB=
ORION_DISK_TOTAL_GB=

# --- Billing ------------------------------------------------------------
# Mocked for the proof of concept. See docs/BILLING.md.
ORION_BILLING_MODE=mock
ORION_CURRENCY=EUR
# Stripe integration point (unused while ORION_BILLING_MODE=mock).
ORION_STRIPE_SECRET_KEY=
ORION_STRIPE_WEBHOOK_SECRET=
